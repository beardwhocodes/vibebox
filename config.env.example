# vibebox config — copy to config.env and fill in. All values optional; missing
# ones fall back to prompts/defaults. config.env is git-ignored (it has secrets).

# --- Tailscale (private SSH access) -----------------------------------------
# Make an enrollment auth key: Tailscale admin > Settings > Keys.
# This key does not edit tailnet policy. Complete SECURITY-SETUP.md after install.
# Keep personal devices untagged; assign tag:vps to the server through the admin console.
TS_AUTHKEY=""
TS_HOSTNAME="vibebox-1"          # how the box appears in your tailnet

# --- Cloudflare Tunnel (public web, outbound, no open ports) ----------------
# Cloudflare dashboard > Zero Trust > Networks > Tunnels > create > copy token.
# In the tunnel's Public Hostname, map your domain -> http://localhost:80.
CF_TUNNEL_TOKEN=""
APP_DOMAIN="app.example.com"     # informational; the hostname you mapped above

# --- Box basics -------------------------------------------------------------
ADMIN_EMAIL="you@example.com"
SSH_PORT="22"                    # 22 is fine (SSH is Tailscale-only anyway)
ROLLBACK_SECONDS="600"           # firewall deadman window

# --- What to install --------------------------------------------------------
INSTALL_CLAUDE="true"            # Claude Code on the box
INSTALL_APP="true"               # nginx + PHP-FPM + SQLite starter
INSTALL_BACKUPS="true"           # installs Litestream only; configure and verify a remote replica
APP_DIR="/srv/app"
APP_DATA_DIR="/srv/data/vibebox"   # private SQLite data; must be outside APP_DIR
